date-released: "2026-09-07"
license: CC-BY-4.0
license-url: "https://creativecommons.org/licenses/by/4.0/"
keywords:
  - fire detection
  - label quality
  - weak supervision
  - MATOPIBA
  - Cerrado
  - remote sensing
  - VIIRS
  - MODIS
  - Sentinel-2
  - inter-source agreement
